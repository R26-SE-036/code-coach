# Keep the build context tiny and keep secrets out of the image.
.git
.gitignore
.dockerignore
Dockerfile

# Secrets and local configuration — NEVER baked into an image
backend/secrets
backend/.env
*.env

# Local environments and caches
backend/.venv
**/__pycache__
**/*.pyc

# Not needed at runtime
data
docs
extension
logs
shared
backend/tests
backend/app/dev_tools
README.md
