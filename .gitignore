# Node
node_modules/
dist/
out/
.vscode-test/

# Python
# Both spellings: `venv/` alone does not match `.venv/`, which is how an entire
# virtualenv (18,925 files) ended up committed to this repo.
venv/
.venv/
env/
.env/
__pycache__/
*.pyc
.pytest_cache/

# Environment files
.env

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
# Secrets (credentials of any kind) - never commit
backend/secrets/
*.serviceaccount.json

# docs/ is tracked on purpose. A "/docs" rule used to sit here, which meant a
# single `git commit -a` would have silently recorded the deletion of every
# file in it.
