flowchart TB
    subgraph CLIENT["«device» Student's Machine — Visual Studio Code"]
        MARKET["«distribution» VS Code Marketplace<br/>(publishes packaged extension via vsce)"]
        subgraph EXT["«component» Code Coach Extension (TypeScript)"]
            EXTTS["extension.ts — activation, commands,<br/>shared ExtensionState"]
            ANALYSIS["analysis.ts — 900 ms debounce,<br/>runAnalysisForEditor, render squiggles + hints"]
            AUTH["auth.ts — register/sign-in/silent restore,<br/>learning sessions, telemetry"]
            API["api.ts — the ONLY HTTP layer,<br/>Bearer attach, 401→refresh retry, SecretStorage"]
            UI["ui/* — status bar, decorations,<br/>coach panel, sidebar, CodeLens"]
        end
        MARKET -. "installs / updates" .-> EXT
    end

    subgraph GCP["«execution environment» Google Cloud — Cloud Run (asia-south1) · Docker (python:3.12-slim, 527 MB) · scales to zero · auto HTTPS"]
        subgraph BACKEND["«component» Code Coach Backend (FastAPI)"]
            ROUTES["API routes /api/v1<br/>auth · learning-sessions · code-coach/analyze<br/>diagnostics · events · dashboard"]
            CORE["core — Argon2id hashing, JWT HS256,<br/>refresh rotation, session revocation"]
            SVc["services — code_coach_service,<br/>learning signals, evaluation logging"]
            subgraph PIPE["analysis pipeline (analyzer.py)"]
                P1["parser_utils<br/>tree-sitter → AST"] --> P2["feature_extractor<br/>AST → 52 features"]
                P2 --> P3["ml_engine<br/>5 LR gates, σ(w·x+b) vs thresholds"]
                P3 --> P4["issue_locators<br/>15 locators → line/col"]
                P4 --> P5["hint_engine<br/>3-level hints"]
            end
            CATALOG["error_catalog — 15 types:<br/>5 ml_gated / 10 rule_only,<br/>calibrated thresholds"] --> PIPE
            ARTIFACTS[("models/*.joblib ×5<br/>knowledge_base/*.json")]
            STORAGE["db — storage seam:<br/>FirestoreStorage (active) | Mongo | InMemory"]
        end
    end

    subgraph FB["«cloud service» Firebase — Cloud Firestore (code-guru-1b5d9)"]
        COLS[("users · authSessions · learningSessions ·<br/>codeDiagnostics · learningEvents ·<br/>remediationTriggers · conceptMastery · collaborationSessions")]
    end

    OTHERS["«planned» Study Guider · Gamification ·<br/>Pair Review Studio (separate repos + DBs)"]

    API == "HTTPS / JSON REST<br/>Bearer JWT (1 h access, rotating refresh)" ==> ROUTES
