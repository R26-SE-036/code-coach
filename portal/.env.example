# Where the Code Coach backend is. This is the platform's identity provider.
VITE_CODE_COACH_URL=http://127.0.0.1:8000

# Origins the portal is allowed to hand a token back to, comma separated.
#
# SECURITY: this list is what stops the portal being an open redirect. Only add
# origins belonging to Code Guru services. Never add a wildcard, and never add
# an origin you do not control.
VITE_ALLOWED_REDIRECTS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:5174

# Where the hub sends students. Shown as links once signed in.
VITE_STUDY_GUIDER_URL=http://localhost:5173
VITE_PAIRPATH_URL=http://localhost:3000
VITE_GAMIFICATION_URL=http://localhost:5174

# Enables /dev-login, the localhost-only sign-in form. Ignored unless the page
# is actually served from localhost. Leave unset in any deployed build.
VITE_ENABLE_DEV_LOGIN=true
